{
    "name": "data-product-portal-client",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "os": [
        "darwin",
        "linux"
    ],
    "scripts": {
        "build": "vite build",
        "build:prd": "vite build --mode production",
        "dev": "npm run copy-config && vite --force",
        "preview": "npm run copy-config && npm run build && vite preview",
        "test": "vitest",
        "test:run": "vitest run",
        "biome": "biome check --error-on-warnings && npm run typecheck && npm run validate-translations",
        "biome:fix": "biome check --write --error-on-warnings && npm run typecheck && npm run validate-translations",
        "biome:migrate": "biome migrate --write",
        "typecheck": "tsc --strict --noEmit",
        "extract-translations": "npx i18next-cli extract",
        "validate-translations": "npx i18next-cli extract --ci --dry-run",
        "lint-translations": "npx i18next-cli lint",
        "copy-config": "cp config.local.js public/config.js",
        "dep-viz": "npm run build && npx open-cli dependencies.html",
        "generate-api": "rm -rf src/store/api/services/generated/* && npx @rtk-query/codegen-openapi src/store/api/openapi-config.ts && node scripts/add-ts-nocheck.js && node scripts/validate-api-errors.js",
        "validate-api-errors": "node scripts/validate-api-errors.js",
        "knip": "knip",
        "postinstall": "patch-package"
    },
    "dependencies": {
        "@ant-design/charts": "^2.6.7",
        "@ant-design/icons": "^6.3.4",
        "@dagrejs/dagre": "^2.0.4",
        "@fontsource/inter": "^5.3.0",
        "@posthog/react": "^1.10.5",
        "@reduxjs/toolkit": "^2.12.0",
        "@tiptap/extension-heading": "^3.31.0",
        "@tiptap/extension-table": "^3.31.0",
        "@tiptap/extension-table-cell": "^3.31.0",
        "@tiptap/extension-table-header": "^3.31.0",
        "@tiptap/extension-table-row": "^3.31.0",
        "@tiptap/extension-text-style": "^3.31.0",
        "@tiptap/extension-typography": "^3.31.0",
        "@tiptap/pm": "^3.31.0",
        "@tiptap/react": "^3.31.0",
        "@tiptap/starter-kit": "^3.31.0",
        "@xyflow/react": "^12.11.5",
        "antd": "^6.6.2",
        "axios": "^1.20.0",
        "clsx": "^2.1.1",
        "date-fns": "^4.4.0",
        "dayjs": "^1.11.23",
        "elkjs": "^0.12.0",
        "esbuild-runner": "^2.2.2",
        "framer-motion": "^13.1.1",
        "i18next": "^26.4.0",
        "i18next-http-backend": "^4.0.1",
        "js-sha256": "^1.0.0",
        "nuqs": "^2.10.1",
        "oidc-client-ts": "^3.5.0",
        "posthog-js": "^1.422.5",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "react-i18next": "^17.0.12",
        "react-oidc-context": "^3.3.1",
        "react-redux": "^9.3.0",
        "react-router": "^8.3.1",
        "react-syntax-highlighter": "^16.1.1",
        "use-debounce": "^10.1.1",
        "web-worker": "^1.5.0"
    },
    "devDependencies": {
        "@biomejs/biome": "2.5.11",
        "@rtk-query/codegen-openapi": "^2.0.0",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.6",
        "@types/node": "^26.4.1",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.5",
        "@types/react-syntax-highlighter": "^15.5.13",
        "@vitejs/plugin-react": "^6.1.1",
        "esbuild": "^0.28.2",
        "i18next-cli": "^1.71.3",
        "jsdom": "^30.0.1",
        "knip": "^6.34.0",
        "msw": "^2.15.0",
        "patch-package": "^8.0.1",
        "rollup-plugin-visualizer": "^7.1.1",
        "sass": "^1.103.1",
        "typescript": "^7.0.2",
        "vite": "^8.2.2",
        "vite-plugin-svgr": "^5.2.0",
        "vitest": "^4.1.11"
    },
    "volta": {
        "node": "22.22.0"
    },
    "engines": {
        "node": ">= 22.0",
        "npm": ">= 11.11.0"
    },
    "overrides": {
        "i18next-parser": {
            "rimraf": "^4.0.0"
        },
        "zustand": {
            "use-sync-external-store": "^1.4.0"
        }
    }
}
